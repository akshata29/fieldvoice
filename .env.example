# FieldVoice settings. Copy this file to ".env" in the repository root (".env" is git-ignored) to override a default.
# Every setting is also an ordinary environment variable, and none is required: the demo runs with no .env at all.
# The Python backend reads ".env" itself; the scripts\*.bat launchers do not (see FV_API_PORT below).

# --- Where things live ----------------------------------------------------------------------------------------------
# Datasets, evaluation runs, benchmark output and the local device store.
# FV_DATA_DIR=./data
# Foundry Local model cache: about 2 GB for the demo, about 20 GB for every model compared in docs/RESULTS.md.
# FV_MODEL_CACHE_DIR=./data/models

# --- Which models the morning work package asks the device to hold --------------------------------------------------
# FV_MANIFEST_STT_ENGINE=foundry:stt:whisper-base:cpu
# FV_MANIFEST_LLM_ENGINE=foundry:llm:qwen2.5-1.5b:cpu

# --- Extraction behaviour -------------------------------------------------------------------------------------------
# How the hybrid pipeline words its question to the language model: v0 .. v4 (docs/RESULTS.md section 2.3).
# FV_PATCH_PROMPT=v4
# Models kept in memory at once; the least recently used is unloaded.
# FV_MAX_LOADED_MODELS=3
# true exposes GPU/NPU model variants. They can fail to load on some devices, so CPU-only is the default.
# FV_FOUNDRY_REGISTER_EPS=false

# --- Labelling ------------------------------------------------------------------------------------------------------
# Stamped on every evaluation run and benchmark, for example latitude-7220.
# FV_DEVICE_PROFILE=dev-box

# --- The system of record the device talks to -----------------------------------------------------------------------
# Empty (default) = the built-in mock system of record, called in process. Set a URL to point at an external service
# that implements the contract in docs/SYSTEMS.md.
# FV_SOR_URL=

# --- Optional: Azure Speech comparison engines (not used by default; docs/RESULTS.md "Azure Speech") ----------------------
# FV_AZURE_SPEECH_KEY=
# FV_AZURE_SPEECH_REGION=
# FV_EMBEDDED_SPEECH_MODEL_PATH=

# --- Port ---------------------------------------------------------------------------------------------------------------
# FV_API_PORT is read from the process environment (not from this file) by scripts\run_demo.bat, scripts\run_backend.bat
# and the Vite dev server. Default 8010 (port 8000 is often taken by Docker or WSL). Example:
#   set FV_API_PORT=8020
#   scripts\run_demo.bat
